<div class="background-container">
  <div class ="background-image">
    <div class="itinerary-bank-container">
      <div class="bank-container">
        <mat-sidenav-container class="sidenav-container">
          <mat-sidenav #sidenav class="sidenav" mode="side" opened>
            <attractions-bank [itineraryDays]="itineraryDays" [timeSlots]="timeSlots"></attractions-bank>
          </mat-sidenav>
          <button class ="toggle-button" matButton (click)="sidenav.toggle()">></button>
        </mat-sidenav-container>
      </div>
        <div class="itinerary-container">
        <div class="itinerary-header">
          <h2>Itinerary</h2>
          <div class="itinerary-description">
            <p>Drag and drop attractions from the bank to create your itinerary.</p>
          </div>
        </div>
        <div class="itinerary-table-container">
        <table mat-table class="itinerary-table" [dataSource]="timeSlots" matSort>
          <!-- Time Column -->
          <ng-container   matColumnDef="time">
            <th mat-header-cell class= "time-column" *matHeaderCellDef> Time </th>
            <td mat-cell  class= "time-column" *matCellDef="let time"> {{ time }} </td>
          </ng-container>

          <!-- Dynamic Day Columns -->
          <ng-container class="day-column" *ngFor="let day of itineraryDays; let dayIndex = index" [matColumnDef]="day.day">
            <th mat-header-cell *matHeaderCellDef> {{ day.day }} </th>
            <td mat-cell *matCellDef="let time">
              <div
                cdkDropList
                class="drop-zone"
                [id]="'drop-zone-' + dayIndex + '-' + time"
                [cdkDropListData]="asAttractionList([])"
                [cdkDropListConnectedTo]="getConnectedDropLists()"
                (cdkDropListDropped)="drop($event, dayIndex, time)">
                <div class="activity"
                     *ngIf="day.activities[time]"
                     cdkDrag
                     [cdkDragData]="day.activities[time]"
                     (cdkDragEnded)="dragEnded($event, dayIndex, time)"
                     [ngClass]="['category-' + day.activities[time].category.toLowerCase(), 'activity-' + dayIndex]">
                  {{ day.activities[time].name }}
                  <ng-template cdkDragPreview>
                    <div class="drag-preview-chip category-{{ day.activities[time].category.toLowerCase() }}"
                         [ngStyle]="previewStyle">
                      {{ day.activities[time].name }}
                    </div>
                  </ng-template>
                </div>
              </div>
            </td>
          </ng-container>

          <tr mat-header-row *matHeaderRowDef="displayedColumns"></tr>
          <tr mat-row *matRowDef="let row; columns: displayedColumns"></tr>
        </table>
        </div>
      </div>
